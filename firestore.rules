rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /likes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count >= 0
                    && math.abs(request.resource.data.count - resource.data.count) == 1;
    }

    match /photos/{photoId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
